---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Sección del menú que se marca como activa al cargar (en las fichas, "portfolio"). */
  section?: 'inicio' | 'sobre-mi' | 'portfolio' | 'contacto';
}

const { title, description = 'Portfolio de Augusto Lupo: realizador audiovisual, director de cámaras, filmmaker y fotógrafo.', section = 'inicio' } = Astro.props;
const links = [['inicio', 'Inicio'], ['sobre-mi', 'Sobre mí'], ['portfolio', 'Portfolio'], ['contacto', 'Contacto']] as const;
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090B" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      // Antes de pintar: marca que hay JS (para las animaciones) y decide si mostrar la intro.
      document.documentElement.classList.add('js');
      try { if (!sessionStorage.getItem('al:intro')) document.documentElement.classList.add('is-loading'); } catch {}
    </script>
  </head>
  <body>
    <div class="loader" aria-hidden="true">
      <div class="loader-count"><span data-loader-count>0</span><em>%</em></div>
      <div class="loader-bar"><i></i></div>
      <p class="loader-label" data-loader-label>Preparando el set…</p>
    </div>
    <canvas class="starfield" aria-hidden="true"></canvas>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Secciones del portfolio">
        <span class="nav-pill" aria-hidden="true"></span>
        {links.map(([id, label]) => (
          <a href={isHome ? `#${id}` : `/#${id}`} data-section={id} aria-current={id === section ? 'location' : undefined}>{label}</a>
        ))}
      </nav>
    </header>
    <main id="contenido" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <span>© {new Date().getFullYear()} Augusto Lupo · Realizador audiovisual</span>
      <a href={isHome ? '#inicio' : '/#inicio'}>Volver arriba ↑</a>
    </footer>
    <script>
      import { runLoader } from '../scripts/loader';
      import { startStarfield } from '../scripts/starfield';
      import { setupNav } from '../scripts/nav';
      import { setupReveal } from '../scripts/reveal';
      runLoader();
      startStarfield(document.querySelector('.starfield')!);
      setupNav();
      setupReveal();
    </script>
  </body>
</html>
