---
import type { Project } from '../data/project-types';
interface Props { project: Project; index: number; hero?: boolean }
const { project, index, hero } = Astro.props;
---
{project.cover ? <img src={project.cover.src} alt={project.cover.alt} style={{ objectPosition: project.coverPosition }} loading={hero ? 'eager' : 'lazy'} /> : (
  <div class={`plate tone-${index % 3}`} aria-hidden="true">
    <small>AL / ARCHIVO · {String(index + 1).padStart(2, '0')}</small>
    <strong>{project.title}</strong>
    <small>{project.categories.join(' / ')}</small>
  </div>
)}
<style>
  img,.plate { width:100%; aspect-ratio:16/9; box-sizing:border-box; }
  img { display:block; object-fit:cover; background:var(--surface-raised); }
  .plate { display:grid; align-content:space-between; padding:5%; gap:.75rem; color:var(--bg); background:var(--accent); }
  small { font:600 .72rem/1.3 monospace; letter-spacing:.1em; text-transform:uppercase; }
  strong { max-width:15ch; font:italic 500 clamp(1.8rem,3.5vw,4rem)/.98 Georgia,serif; letter-spacing:-.04em; }
  .tone-1 { background:var(--surface-raised); color:var(--text); text-align:right; justify-items:end; }
  .tone-1 strong { font-family:system-ui,sans-serif; font-style:normal; }
  .tone-2 { background:var(--text); border-left:1rem solid var(--accent); }
</style>
