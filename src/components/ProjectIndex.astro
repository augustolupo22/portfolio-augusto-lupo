---
import { projects } from '../data/projects';
import { categories } from '../data/project-types';
import ProjectCover from './ProjectCover.astro';
---
<section id="proyectos" aria-labelledby="work-heading">
  <p class="folio">02 / PROYECTOS</p>
  <h2 id="work-heading" lang="en" data-reveal>Selected Work</h2>
  <p>Una selección de historias, producciones y experiencias detrás de cámara.</p>
  <aside id="recorrido" aria-labelledby="recorrido-heading" hidden>
    <h3 id="recorrido-heading">Retomar recorrido</h3>
    <p role="status"></p>
    <ol></ol>
    <button type="button" hidden>Borrar historial</button>
  </aside>
  <div class="filters" role="group" aria-label="Filtrar proyectos por categoría" hidden>
    {['Todos', ...categories].map(label => <button type="button" data-filter={label} aria-pressed={label === 'Todos'}>{label}</button>)}
  </div>
  <p role="status" class="status">{projects.length ? '' : 'No hay proyectos en esta categoría.'}</p>
  <div class="grid">
    {projects.map((project, index) => <article data-reveal data-categories={project.categories.join('|')}>
      <div class="cover"><ProjectCover {project} {index} /></div>
      <p>{project.categories.join(' · ')}{project.year && ` / ${project.year}`}</p><h3>{project.title}</h3><p>{project.description}</p>
      <a href={`/proyectos/${project.slug}/`} data-slug={project.slug} aria-label={`Ver ficha: ${project.title}`}>Ver ficha <span aria-hidden="true">↗</span></a>
    </article>)}
  </div>
</section>
<script>
  import { historyKey, readVisits } from '../lib/recorrido';
  const section = document.querySelector('#proyectos .filters')?.closest('section');
  if (section) {
    const filters = section.querySelector<HTMLElement>('.filters')!;
    const buttons = filters.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = section.querySelectorAll<HTMLElement>('[data-categories]');
    const status = section.querySelector<HTMLElement>('.status')!;
    buttons.forEach(button => button.addEventListener('click', () => {
      const key = button.dataset.filter!;
      buttons.forEach(other => other.setAttribute('aria-pressed', String(other === button)));
      let count = 0;
      cards.forEach(card => {
        card.hidden = key !== 'Todos' && !card.dataset.categories!.split('|').includes(key);
        if (!card.hidden) count++;
      });
      status.textContent = count ? `Proyectos visibles: ${count}` : 'No hay proyectos en esta categoría.';
    }));
    filters.hidden = false;

    const panel = section.querySelector<HTMLElement>('#recorrido')!;
    const message = panel.querySelector<HTMLElement>('[role=status]')!;
    const list = panel.querySelector('ol')!;
    const clear = panel.querySelector('button')!;
    const catalog = new Map(Array.from(cards, card => {
      const link = card.querySelector<HTMLAnchorElement>('a[data-slug]')!;
      return [link.dataset.slug!, { href: link.href, title: card.querySelector('h3')!.textContent! }];
    }));

    function refresh() {
      list.replaceChildren();
      try {
        const visits = readVisits();
        for (const slug of visits) {
          const project = catalog.get(slug);
          if (!project) continue;
          const link = document.createElement('a');
          link.href = project.href;
          link.textContent = project.title;
          list.appendChild(document.createElement('li')).append(link);
        }
        message.textContent = list.childElementCount ? 'Últimas fichas abiertas en este navegador, de más reciente a más antigua.' : 'Todavía no hay fichas disponibles en tu recorrido.';
        clear.hidden = !visits.length;
      } catch {
        message.textContent = 'No se pudo leer el historial en este navegador.';
        clear.hidden = false;
      }
      list.hidden = !list.childElementCount;
      panel.hidden = false;
    }
    clear.addEventListener('click', () => {
      try {
        localStorage.removeItem(historyKey);
        refresh();
      } catch {
        message.textContent = 'No se pudo borrar el historial en este navegador.';
      }
    });
    window.addEventListener('pageshow', refresh);
    window.addEventListener('storage', event => {
      if (event.key === historyKey || event.key === null) refresh();
    });
  }
</script>
<style>
  section { padding:clamp(3rem,7vw,7rem) 5%; background:var(--bg); color:var(--text); }
  .folio,a { color:var(--accent); } .folio { font:.8rem monospace; letter-spacing:.14em; }
  h2 { margin:.3em 0; font:500 clamp(3rem,8vw,7rem)/1 Georgia,serif; letter-spacing:-.06em; }
  .filters:not([hidden]) { display:flex; flex-wrap:wrap; gap:.5rem; margin-top:2rem; }
  button { padding:.7rem 1rem; background:transparent; color:inherit; border:1px solid #748096; border-radius:2rem; cursor:pointer; font:inherit; }
  button[aria-pressed=true] { background:var(--accent); color:var(--bg); }
  @media (hover:hover) {
    .filters button:hover { border-color:var(--text); }
    a[data-slug]:hover { text-decoration-thickness:2px; }
  }
  :is(button,a):focus-visible { outline:3px solid var(--accent); outline-offset:3px; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr)); gap:2rem; }
  article { border:1px solid #748096; padding:0 0 .8rem; }
  article > :not(.cover) { margin-inline:.8rem; }
  .cover { overflow:hidden; }
  @media (hover:hover) {
    article:hover { border-color:var(--accent); }
  }
  @media (hover:hover) and (prefers-reduced-motion:no-preference) {
    article { transition:transform .2s ease-out; }
    article:hover { transform:translateY(-3px); }
  }
  h3 { margin:1rem 0 .4rem; font-size:1.45rem; } article p { margin:.4rem 0 1rem; }
  .status { min-height:1.4em; }
  #recorrido { margin-top:2rem; padding-left:1rem; border-left:2px solid var(--accent); }
  #recorrido :global(a) { color:var(--accent); }
  @media(prefers-reduced-motion:no-preference) {
    button { transition:background-color .2s,color .2s; }
    button:active { translate:0 1px; }
  }
</style>
