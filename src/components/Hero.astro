---
// Portada: presentación, roles que se escriben solos y la credencial colgante (3D o estática).
import CameraPass from './CameraPass.astro';
import Icon from './Icon.astro';
import LanyardIsland from './lanyard/LanyardIsland';
import { profile } from '../data/profile';

const { name, roles, intro, portrait, portraitFocus, contact } = profile;
const badgeData = {
  name,
  role: roles[0],
  footer: 'Foto · Video · Streaming',
  handle: contact.socials[0]?.handle ?? '',
  site: 'portfolio-augusto-lupo.vercel.app',
  portrait: portrait.src,
  focusY: portraitFocus,
};
---
<section id="inicio" class="hero shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow hero-in" style="--i:0">Portfolio audiovisual</p>
    <h1 id="hero-title" class="hero-in" style="--i:1">
      <span class="hello">Hola, soy</span>
      <span class="gradient-text">{name.split(' ')[0]}</span> {name.split(' ').slice(1).join(' ')}
    </h1>
    <p class="roles hero-in" style="--i:2">
      <span class="sr-only">{roles.join(', ')}</span>
      <span aria-hidden="true" data-typewriter={JSON.stringify(roles)}>{roles[0]}</span><i class="caret" aria-hidden="true"></i>
    </p>
    <p class="intro hero-in" style="--i:3">{intro}</p>
    <div class="actions hero-in" style="--i:4">
      <a class="btn btn-primary" href="#portfolio">Ver proyectos <Icon name="arrow-right" /></a>
      <a class="btn" href="#contacto">Contactame <Icon name="send" /></a>
    </div>
    <div class="find hero-in" style="--i:5">
      <span>Encontrame</span>
      {contact.socials.map(s => <a href={s.url} target="_blank" rel="noopener" aria-label={`${s.label} (${s.handle})`}><Icon name={s.icon as 'instagram'} /></a>)}
      <a href={`mailto:${contact.email}`} aria-label={`Email: ${contact.email}`}><Icon name="mail" /></a>
    </div>
  </div>

  <div class="badge-stage" data-badge>
    <div class="badge-fallback"><CameraPass {name} {portrait} /></div>
    <LanyardIsland client:only="react" data={badgeData} />
  </div>

  <a class="scroll-cue" href="#sobre-mi" aria-label="Bajar a Sobre mí"><i></i></a>
</section>

<script>
  import { introDone } from '../scripts/loader';
  // Escribe y borra los roles uno por uno. El texto completo está disponible para lectores de pantalla.
  const target = document.querySelector<HTMLElement>('[data-typewriter]');
  if (target && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words: string[] = JSON.parse(target.dataset.typewriter!);
    let word = 0, chars = words[0].length, deleting = true;
    const step = () => {
      const current = words[word];
      chars += deleting ? -1 : 1;
      target.textContent = current.slice(0, chars);
      let delay = deleting ? 38 : 70;
      if (!deleting && chars === current.length) { deleting = true; delay = 1900; }
      else if (deleting && chars === 0) { deleting = false; word = (word + 1) % words.length; delay = 300; }
      setTimeout(step, delay);
    };
    introDone().then(() => setTimeout(step, 2200));
  }
</script>

<style>
  .hero { position: relative; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); align-items: center; gap: 2rem; min-height: 100svh; padding-top: 6rem; padding-bottom: 4rem; }
  h1 { font-size: clamp(3.4rem, 8.4vw, 7rem); font-weight: 750; line-height: .95; margin-top: 1.1rem; }
  .hello { display: block; font-size: .36em; font-weight: 500; letter-spacing: -.02em; color: var(--muted); margin-bottom: .35em; }
  .roles { margin-top: 1.4rem; font: 500 clamp(1.05rem, 1.7vw, 1.35rem) var(--mono); color: var(--accent-soft); min-height: 1.6em; }
  .caret { display: inline-block; width: 2px; height: 1.1em; margin-left: 3px; vertical-align: -.15em; background: var(--accent); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .intro { margin-top: 1.2rem; max-width: 48ch; color: var(--muted); font-size: clamp(1rem, 1.25vw, 1.1rem); }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .find { display: flex; align-items: center; gap: .55rem; margin-top: 2.2rem; }
  .find span { font: 500 .72rem var(--mono); letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin-right: .4rem; }
  .find a { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: .7rem; border: 1px solid var(--border); background: rgb(255 255 255 / .03); color: var(--muted); font-size: 1.1rem; transition: color .25s, border-color .25s, transform .35s var(--ease-out); }
  .find a:hover { color: var(--text); border-color: rgb(147 197 253 / .5); transform: translateY(-3px); }

  .badge-stage { position: relative; height: min(84svh, 760px); min-height: 520px; }
  .badge-stage :global(astro-island) { position: absolute; inset: 0; }
  .badge-fallback { position: absolute; inset: 0; display: grid; place-items: center; transition: opacity .6s; }
  .badge-stage[data-mode='3d'] .badge-fallback { opacity: 0; visibility: hidden; }
  .badge-fallback :global(.stage) { width: 100%; height: 100%; }
  .badge-stage :global(.badge-hint) { position: absolute; left: 50%; bottom: .5rem; translate: -50% 0; margin: 0; padding: .45rem .9rem; border-radius: 99px; border: 1px solid var(--border); background: rgb(10 15 28 / .7); color: var(--muted); font: 500 .75rem var(--mono); letter-spacing: .08em; white-space: nowrap; pointer-events: none; transition: opacity .6s; animation: hint-in .8s 1.2s var(--ease-out) backwards; }
  .badge-stage :global(.badge-hint.is-done) { opacity: 0; }
  @keyframes hint-in { from { opacity: 0; translate: -50% 10px; } }

  .scroll-cue { position: absolute; left: 50%; bottom: 1.5rem; translate: -50% 0; width: 1.5rem; height: 2.4rem; border: 1.5px solid var(--border-strong); border-radius: 99px; }
  .scroll-cue i { position: absolute; left: 50%; top: .45rem; width: 3px; height: .5rem; margin-left: -1.5px; border-radius: 3px; background: var(--accent-soft); animation: wheel 1.8s var(--ease-out) infinite; }
  @keyframes wheel { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateY(.8rem); } }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-in { animation: hero-in 1s var(--ease-out) both; animation-delay: calc(var(--i) * 90ms + 150ms); }
    :global(html.is-loading) .hero-in { animation-play-state: paused; }
    @keyframes hero-in { from { opacity: 0; transform: translateY(26px); filter: blur(6px); } }
  }
  @media (prefers-reduced-motion: reduce) { .caret, .scroll-cue i { animation: none; } }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; padding-top: 7rem; gap: 0; }
    .badge-stage { height: 30rem; min-height: 0; }
    .scroll-cue { display: none; }
  }
</style>
